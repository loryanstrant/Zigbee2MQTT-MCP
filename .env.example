# --- Zigbee2MQTT frontend -----------------------------------------------------
# Base URL of the Zigbee2MQTT frontend. The websocket URL (ws(s)://.../api) is
# derived automatically (https -> wss, http -> ws).
Z2M_FRONTEND_URL=https://zigbee2mqtt.example.com

# Frontend auth_token (Zigbee2MQTT `frontend.auth_token`). Leave empty if the
# frontend has no authentication. When set it is appended as ?token=...
Z2M_AUTH_TOKEN=

# Skip TLS verification for wss:// (only for self-signed certs).
Z2M_TLS_INSECURE=false

# Seconds to wait for a bridge/response before timing out.
Z2M_REQUEST_TIMEOUT=15

# Seconds to wait at startup for the initial device snapshot.
Z2M_CONNECT_TIMEOUT=20

# Enable device/group management + permit_join tools. Off by default so an LLM
# cannot remove/reconfigure devices unless you opt in.
Z2M_ALLOW_DESTRUCTIVE=false

# --- MCP transport ------------------------------------------------------------
# 'http' (streamable HTTP, for a hosted server) or 'stdio' (local MCP client).
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8080
MCP_PATH=/mcp

# DNS-rebind Host/Origin protection: false (default, no checks), true, or auto.
# Leave false unless you want to restrict which Host headers are accepted.
MCP_HOST_PROTECTION=false

# Comma-separated Host header allowlist, used only when MCP_HOST_PROTECTION is
# enabled. Supports fnmatch wildcards (e.g. *.example.com).
MCP_ALLOWED_HOSTS=*.example.com,localhost,127.0.0.1

MCP_LOG_LEVEL=INFO
